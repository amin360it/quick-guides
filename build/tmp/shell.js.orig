(function () {
  var nav = document.getElementById('topnav');
  if (!nav || nav.querySelector('.tn-item')) return;

  // A hub page may still carry the older single-panel markup. The tree below
  // replaces it so every page renders the same control.
  nav.innerHTML = '';

  var NS = 'http://www.w3.org/2000/svg';
  var item = document.createElement('div');
  item.className = 'tn-item';

  var btn = document.createElement('button');
  btn.type = 'button';
  btn.className = 'tn-btn';
  btn.id = 'tnGuidesBtn';
  btn.setAttribute('aria-haspopup', 'true');
  btn.setAttribute('aria-expanded', 'false');
  btn.textContent = 'Guides';
  var caret = document.createElementNS(NS, 'svg');
  caret.setAttribute('class', 'tn-caret');
  caret.setAttribute('viewBox', '0 0 24 24');
  caret.setAttribute('fill', 'none');
  caret.setAttribute('stroke', 'currentColor');
  caret.setAttribute('stroke-width', '2.5');
  caret.setAttribute('stroke-linecap', 'round');
  caret.setAttribute('stroke-linejoin', 'round');
  caret.setAttribute('aria-hidden', 'true');
  var p = document.createElementNS(NS, 'path');
  p.setAttribute('d', 'm9 5 7 7-7 7');
  caret.appendChild(p);
  btn.appendChild(caret);
  item.appendChild(btn);

  var menu = document.createElement('div');
  menu.className = 'tn-menu';
  menu.setAttribute('role', 'group');
  menu.setAttribute('aria-label', 'All guides');

  var filterBox = document.createElement('div');
  filterBox.className = 'tn-filter';
  var input = document.createElement('input');
  input.type = 'search';
  input.placeholder = 'Filter guides\u2026';
  input.setAttribute('aria-label', 'Filter guides');
  input.setAttribute('autocomplete', 'off');
  filterBox.appendChild(input);
  menu.appendChild(filterBox);

  var scroll = document.createElement('div');
  scroll.className = 'tn-scroll';
  var links = [];
  var currentFile = (location.pathname.split('/').pop() || '') ;
  for (var g = 0; g < GUIDES_CATALOG.length; g++) {
    var group = GUIDES_CATALOG[g];
    var head = document.createElement('div');
    head.className = 'tn-cat-h';
    head.textContent = group.name;
    scroll.appendChild(head);
    for (var k = 0; k < group.guides.length; k++) {
      var gd = group.guides[k];
      var a = document.createElement('a');
      a.className = 'tn-link';
      a.href = gd[0];
      a.setAttribute('data-file', gd[0]);
      a.setAttribute('data-cat', group.id);
      a.textContent = gd[1];
      if (gd[0] === currentFile) a.className += ' cur';
      scroll.appendChild(a);
      links.push(a);
    }
  }
  menu.appendChild(scroll);

  var note = document.createElement('a');
  note.className = 'tn-menu-note';
  note.href = 'index.html#guides';
  note.textContent = 'All guides and topics \u203A';
  menu.appendChild(note);

  item.appendChild(menu);
  nav.appendChild(item);

  function setOpen(open, focusInput) {
    item.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open && focusInput && input) { try { input.focus(); } catch (e) {} }
  }

  btn.addEventListener('click', function (e) {
    e.stopPropagation();
    setOpen(!item.classList.contains('open'), !item.classList.contains('open'));
  });

  // Desktop hover opens the menu; leaving it closes unless focus is inside.
  item.addEventListener('mouseenter', function () {
    if (window.matchMedia && window.matchMedia('(hover: hover)').matches) setOpen(true, false);
  });
  item.addEventListener('mouseleave', function () {
    if (!document.activeElement || !item.contains(document.activeElement)) setOpen(false, false);
  });

  document.addEventListener('click', function (e) {
    if (!item.classList.contains('open')) return;
    if (item.contains(e.target)) return;
    setOpen(false, false);
  });

  document.addEventListener('keydown', function (e) {
    if (!item.classList.contains('open')) return;
    if (e.key === 'Escape') { setOpen(false, false); btn.focus(); }
  });

  input.addEventListener('input', function () {
    var q = input.value.trim().toLowerCase();
    for (var i = 0; i < links.length; i++) links[i].style.display = '';
    var kids = scroll.children;
    for (var k2 = 0; k2 < kids.length; k2++) {
      if (kids[k2].classList.contains('tn-cat-h')) kids[k2].style.display = '';
    }
    if (!q) return;
    for (var j = 0; j < links.length; j++) {
      links[j].style.display = (links[j].textContent.toLowerCase().indexOf(q) !== -1) ? '' : 'none';
    }
    // hide a category header when none of its links are visible
    for (var hh = 0; hh < kids.length; hh++) {
      if (!kids[hh].classList.contains('tn-cat-h')) continue;
      var any = false;
      for (var ss = hh + 1; ss < kids.length; ss++) {
        var sib = kids[ss];
        if (sib.classList.contains('tn-cat-h')) break;
        if (sib.style.display !== 'none') { any = true; break; }
      }
      if (!any) kids[hh].style.display = 'none';
    }
  });
})();