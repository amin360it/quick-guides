/* ==========================================================================
   Amin360iT | Quick Guides - shared script
   Theme and colour-mode handling, sidebar, table of contents, search, reading
   progress and per-chapter prev/next navigation. One copy, shared by every
   guide instead of duplicated 33 times.
   Nothing in this file is guide-specific.
   ========================================================================== */

// TWO INDEPENDENT AXES, and why they are two rather than one
// data-theme = light | dark      the LIGHTNESS axis. Unchanged since launch,
// so the pre-paint script, every verifier and every existing page keep working.
// data-mode  = one of ten        the COLOUR axis. A palette family, each
// with its own light and dark variant.

// Folding them together would have meant either twenty data-theme values or
// throwing away the two-valued attribute every check depends on. Keeping them
// orthogonal means a mode can be added without touching the theme logic, and
// the light/dark behaviour that already shipped is untouched.

// The light theme previously had NO light code theme: :root declared a dark
// navy --code-bg and four of the seven code tokens were byte-identical to the
// dark theme's values, so code blocks never actually changed. That is fixed in
// the CSS, where the base :root block now carries real light code colours, and
// the mode blocks are an override of a correct base rather than a mask over a
// wrong one.

/* ==========================================================================
   Amin360iT | Pre-paint script
   Runs before first paint so there is no flash of wrong theme/mode.
   Reads from localStorage and sets data-theme and data-mode on <html>.
   Defaults: dark theme + default mode.
   ========================================================================== */

// KEYS for localStorage
var THEME_KEY = 'amin360it-theme';
var MODE_KEY = 'amin360it-mode';

// The ten valid colour-mode ids. Stored either as one of these or absent; a
// stale id is rejected rather than trusted (see readMode).
var MODE_IDS = ['default', 'nord', 'dracula', 'tokyo', 'rose', 'gruvbox', 'mocha', 'solar', 'paper', 'midnight'];

// Read stored theme (only 'dark' or 'light' are valid)
function readStored() {
  try {
    var v = localStorage.getItem(THEME_KEY);
    return (v === 'dark' || v === 'light') ? v : null;
  } catch (e) { return null; }
}

// Read stored mode (must be one of the 10 MODES ids)
function readMode() {
  try {
    var v = localStorage.getItem(MODE_KEY);
    // an unknown id is rejected rather than trusted: a stale key from a
    // renamed mode would otherwise leave the page with no palette at all
    return MODE_IDS.indexOf(v) !== -1 ? v : null;
  } catch (e) { return null; }
}

// System theme (OS preference), used only if no stored preference exists
function systemTheme() {
  return (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
}

// Apply a theme name, storing it and updating chrome
function applyTheme(next) {
  var root = document.documentElement;
  root.setAttribute('data-theme', next);
  try { localStorage.setItem(THEME_KEY, next); } catch (e) {}
  syncChrome();
}

// Apply a mode name, storing it and updating chrome
function applyMode(id) {
  if (MODE_IDS.indexOf(id) === -1) id = 'default';
  var root = document.documentElement;
  root.setAttribute('data-mode', id);
  try { localStorage.setItem(MODE_KEY, id); } catch (e) {}
  syncChrome();
}

// syncChrome updates the UI chrome (theme icons + labels) from the current
// theme, and is called from applyTheme / applyMode on every page. The actual
// CSS token values live in assets/shell.css blocks that target
// html[data-theme="light"], html[data-theme="dark"], etc.
function syncChrome() {
  var d = document.documentElement.getAttribute('data-theme') === 'dark';
  var sun = document.getElementById('icSun');
  var moon = document.getElementById('icMoon');
  var lbl = document.getElementById('themeLabel');
  var btn = document.getElementById('themeBtn');
  if (sun) sun.style.display = d ? 'none' : '';
  if (moon) moon.style.display = d ? '' : 'none';
  if (lbl) lbl.textContent = d ? 'Light mode' : 'Dark mode';
  if (btn) btn.setAttribute('title', d ? 'Switch to light mode' : 'Switch to dark mode');
}

// PRE-PAINT: runs before first paint so there is no flash of wrong theme/mode
// This reads from localStorage and sets data-theme and data-mode on <html>
// Defaults: dark theme + default mode (matches the original behaviour).
(function() {
  var r = document.documentElement;
  try {
    var s = localStorage.getItem(THEME_KEY),
        d = (s === 'dark' || s === 'light') ? s : 'dark',
        m = localStorage.getItem(MODE_KEY);
    r.setAttribute('data-theme', d);
    r.setAttribute('data-mode', m || 'default');
  } catch (e) {}
})();

// ==========================================================================
// Theme toggle button (dark/light)
// ==========================================================================

// Get the theme button element and add click listener
var themeBtn = document.getElementById('themeBtn');
if (themeBtn) {
  themeBtn.addEventListener('click', function () {
    // Toggle whatever is showing NOW. Basing the toggle on the stored value
    // made the first click a no-op for a first-time visitor (nothing stored).
    var cur = document.documentElement.getAttribute('data-theme');
    applyTheme(cur === 'dark' ? 'light' : 'dark');
  });
}

// ==========================================================================
// Mode picker (10 colour palettes)
// ==========================================================================

// Get the mode button, popover, and related elements
var modeBtn = document.getElementById('modeBtn');
var modePop = document.getElementById('modePop');
var modeSwatch = document.getElementById('modeSwatch');
var modeLabel = document.getElementById('modeLabel');

// Build the mode picker list from the MODES array
var MODES = [
  { id: 'default', label: 'Amin360iT', swatch: '#00d1ff' },
  { id: 'nord',    label: 'Nord',       swatch: '#88c0d0' },
  { id: 'dracula', label: 'Dracula',    swatch: '#bd93f9' },
  { id: 'tokyo',   label: 'Tokyo Night', swatch: '#7aa2f7' },
  { id: 'rose',    label: 'Rose Pine',  swatch: '#c4a7e7' },
  { id: 'gruvbox', label: 'Gruvbox',    swatch: '#fe8019' },
  { id: 'mocha',   label: 'Catppuccin', swatch: '#cba6f7' },
  { id: 'solar',   label: 'Solarized',  swatch: '#268bd2' },
  { id: 'paper',   label: 'Paper',      swatch: '#a8632a' },
  { id: 'midnight', label: 'Midnight',  swatch: '#00e5a0' }
];

// Populate the mode popover if it doesn't already have children
if (modePop && !modePop.children.length) {
  for (var i = 0; i < MODES.length; i++) {
    var m = MODES[i];
    var row = document.createElement('button');
    row.type = 'button';
    row.className = 'mode-opt';
    row.setAttribute('data-mode', m.id);
    row.setAttribute('role', 'menuitemradio');
    row.title = m.label + (m.id === 'default' ? ' (brand)' : '');
    var dot = document.createElement('span');
    dot.className = 'mode-dot';
    dot.style.background = m.swatch;
    var txt = document.createElement('span');
    txt.className = 'mode-name';
    txt.textContent = m.label;
    var tick = document.createElement('span');
    tick.className = 'mode-tick';
    tick.setAttribute('aria-hidden', 'true');
    tick.textContent = '\u25B6';
    row.appendChild(dot);
    row.appendChild(txt);
    row.appendChild(tick);
    modePop.appendChild(row);
  }
}

// Mode popover click handler - apply the selected mode and close
if (modePop) {
  modePop.addEventListener('click', function (e) {
    var row = e.target.closest ? e.target.closest('[data-mode]') : null;
    if (!row) return;
    applyMode(row.getAttribute('data-mode'));
    close();
    modeBtn.focus();
  });
}

// Open/close functionality for the mode popover
function open() {
  modePop.hidden = false;
  modeBtn.setAttribute('aria-expanded', 'true');
  // focus the current selection so a keyboard user lands on the right row
  var cur = modePop.querySelector('[aria-checked="true"]');
  (cur || modePop.firstChild).focus();
}
function close() {
  modePop.hidden = true;
  modeBtn.setAttribute('aria-expanded', 'false');
}
function isOpen() { return !modePop.hidden; }

// Mode button click toggles open/close
if (modeBtn) {
  modeBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    if (isOpen()) close(); else open();
  });
}

// Close when clicking outside the popover
if (modePop) {
  document.addEventListener('click', function (e) {
    if (!isOpen()) return;
    if (modePop.contains(e.target) || modeBtn.contains(e.target)) return;
    close();
  });
}

// Keyboard navigation for the mode popover
if (modePop) {
  document.addEventListener('keydown', function (e) {
    if (!isOpen()) return;
    var rows = Array.prototype.slice.call(modePop.querySelectorAll('[data-mode]'));
    var at = rows.indexOf(document.activeElement);
    if (e.key === 'Escape') { close(); modeBtn.focus(); return; }
    if (e.key === 'Tab') { close(); return; }
    if (e.key === 'ArrowDown') { var next = (at + 1) % rows.length; e.preventDefault(); rows[next].focus(); }
    else if (e.key === 'ArrowUp') { var next = (at - 1 + rows.length) % rows.length; e.preventDefault(); rows[next].focus(); }
    else if (e.key === 'Home') { e.preventDefault(); rows[0].focus(); }
    else if (e.key === 'End') { e.preventDefault(); rows[rows.length - 1].focus(); }
  });
}

// Initial mode setup: read stored mode, apply it, then sync
// If no stored mode, the pre-paint script already set a default
(function() {
  var storedMode = readMode();
  if (storedMode) {
    applyMode(storedMode);
  } else {
    // No stored mode: the pre-paint script already set a default
    // syncChrome to apply the CSS tokens for the default palette
    syncChrome();
  }
})();

// ==========================================================================
// Top-bar GUIDES menu (every page)
// A single "Guides" dropdown in #topnav. The markup it builds matches the
// .topnav .tn-item / .tn-menu design in shell.css; this is the one place the
// catalog lives, so a guide added to index.html only needs its card there.
